{
   "name": "nutrition-toolkit",
   "version": "0.1.2",
   "description": "Food Logging app to find foods with desired number of calories, carbs, protein and fat.",
   "main": "server.js",
   "scripts": {
      "fix": "prettier . --fix && eslint . --ext .ts,.tsx --fix",
      "check:lint": "eslint . --ext .ts,.tsx",
      "check:format": "prettier . --check",
      "check:type": "tsc --project tsconfig.json --noEmit",
      "check": "concurrently -n 'lint,format,type' -c 'bgGreen.bold,bgBlue.bold,bgRed.bold' \"npm:check:lint\" \"npm:check:format\" \"npm:check:type\" ",
      "test:jest": "jest",
      "test:cypress": "cypress open",
      "test:cypress-CLI": "cypress run --record --key 8fe96491-f3d2-4a36-93eb-6cd5688f93e0 ",
      "test": "jest --testPathPattern=src/client --collect-coverage",
      "dev:frontend": "webpack serve --config webpack.dev.js",
      "dev:server": "tsx --watch --tsconfig tsconfig.server.json ./src/server/server.ts",
      "dev": "concurrently -n 'server, webpack' -c 'bgGreen.bold,bgBlue.bold' \"npm run dev:server\" \"wait-on http://localhost:8080 && npm run dev:frontend\" ",
      "build:frontend": "webpack --config webpack.prod.js",
      "build:server": "tsc --project tsconfig.server.json",
      "build": "concurrently -n 'frontend,server' -c 'bgGreen.bold,bgBlue.bold' \"npm:build:frontend\" \"npm:build:server\"",
      "start": "node ./dist/server/server.js",
      "pm2": "pm2 start npm --name 'nutritiontoolkit' -- start "
   },
   "repository": {
      "type": "git",
      "url": "git+https://github.com/cristianordonez/nutrition-toolkit.git"
   },
   "author": "Cristian Ordonez",
   "license": "ISC",
   "bugs": {
      "url": "https://github.com/cristianordonez/nutrition-toolkit/issues"
   },
   "homepage": "https://github.com/cristianordonez/nutrition-toolkit#readme",
   "overrides": {
      "@emotion/react": "11.13.5",
      "@emotion/styled": "11.13.5"
   },
   "dependencies": {
      "@date-io/date-fns": "^2.14.0",
      "@emotion/react": "11.13.5",
      "@emotion/styled": "11.13.5",
      "@mui/icons-material": "^5.8.4",
      "@mui/material": "^5.8.4",
      "@mui/x-date-pickers": "^5.0.0-alpha.7",
